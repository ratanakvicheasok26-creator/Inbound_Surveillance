# Fireworks AI API Key for Tier 2 Vision Auditor
# Get your API key from https://fireworks.ai/api-keys
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4-flash-vision-exp

# Optional shared Telegram bot (also configurable in Hub → Integrations).
# Never commit a real bot token. Export in your shell or local .env:
#   export TELEGRAM_BOT_TOKEN=...
#   export TELEGRAM_CHAT_ID=...
#   export TELEGRAM_STAFF_CHAT_ID=...   # ops / front-desk (fallback: TELEGRAM_CHAT_ID)
#   export TELEGRAM_OWNER_CHAT_ID=...   # executive summaries (fallback: TELEGRAM_CHAT_ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_STAFF_CHAT_ID=
TELEGRAM_OWNER_CHAT_ID=

# Supabase operator accounts.
# Use the publishable/anon key only. Never put the service_role/secret key in the frontend.
VITE_SUPABASE_URL=https://rmepwjywobowktdmkusu.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here

# Optional: Google App Password for local Supabase CLI SMTP testing
# GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

