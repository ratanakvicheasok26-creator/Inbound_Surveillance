# Champei Spa Edge Production Configuration
BRANCH_ID=champei-pp-01
VENUE_NAME="Champei Spa"
TZ=Asia/Phnom_Penh

# Telegram Bot & Chat IDs
TELEGRAM_BOT_TOKEN=
TELEGRAM_STAFF_CHAT_ID=
TELEGRAM_OWNER_CHAT_ID=

# Server & Network Ports
HUB_PORT=8000

# Weekly Customer Activity Brief (sent to the owner chat once per week)
# Delivered every Sunday at WEEKLY_CUSTOMER_BRIEF_AT (24h, local TZ).
# Contents: each customer's usual visit time, most frequent customer, busiest day.
WEEKLY_CUSTOMER_BRIEF_ENABLED=true
WEEKLY_CUSTOMER_BRIEF_AT=21:00
